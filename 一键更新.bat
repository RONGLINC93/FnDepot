@echo off
chcp 65001 >nul 2>&1

rem ---------------------------------------------------------------------------
rem  一键更新仓库
rem  依次执行：① 更新仓库（update.js，只同步每个仓库最新版本）
rem            ② 推送到远程（push.js）
rem  两步之间会检查上一步是否成功，失败则立即停止，不会继续推送。
rem  如需完整同步全部历史版本，请改用 深度更新仓库.bat。
rem  （若仓库对完整性有校验要求，推送前可手动运行 python scripts/validate.py）
rem ---------------------------------------------------------------------------

echo ============================================
echo [1/2] 更新仓库（同步最新版本）...
echo ============================================
node "%~dp0update.js" %*
if errorlevel 1 (
    echo.
    echo [ERROR] 更新仓库失败，已中止，未执行推送。请查看上方信息。
    call :countdown 5
    exit /b 1
)

echo.
echo ============================================
echo [2/2] 推送到远程仓库...
echo ============================================
node "%~dp0push.js" %*
if errorlevel 1 (
    echo.
    echo [ERROR] 推送失败。请查看上方信息。
    call :countdown 5
    exit /b 1
)

echo.
echo 一键更新完成。
call :countdown 5
exit /b 0

rem ---------------------------------------------------------------------------
rem  :countdown <秒数>
rem  从 <秒数> 倒数到 0, 每秒打印剩余秒数 (Ctrl+C 可中断).
rem  本子例程只倒计时不退出, 调用方负责 exit /b.
rem ---------------------------------------------------------------------------
:countdown
echo.
echo %~1 秒后自动关闭窗口... (按 Ctrl+C 取消)
for /l %%i in (%~1,-1,1) do (
    echo   %%i...
    ping -n 2 127.0.0.1 >nul
)
exit /b 0
