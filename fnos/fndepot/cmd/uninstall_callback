#!/usr/bin/env bash
# ============================================================================
# FnDepot 卸载完成回调（fnOS 卸载后调用 cmd/uninstall_callback）
# ============================================================================
set -e
# 卸载向导（wizard/uninstall）采集用户选择，结果以 wizard_data_action 环境变量传入：
#   keep  -> 保留数据（TRIM_PKGVAR/data，含设置/Token），不删除
#   delete-> 删除所有数据
# 注：TRIM_PKGVAR 位于安装目录之外，fnOS 默认不会自动删除，故由本回调按选择处理。
ACTION="${wizard_data_action:-keep}"
if [ "${ACTION}" = "delete" ]; then
    rm -rf "${TRIM_PKGVAR}/data" 2>/dev/null || true
    echo "FnDepot：已按用户选择删除所有应用数据。" >&2
else
    echo "FnDepot：已按用户选择保留应用数据（${TRIM_PKGVAR}/data）。" >&2
fi
exit 0
